{
  "id": "./",
  "name": "Still — school tasks",
  "short_name": "Still",
  "description": "A calm, private list for the next school task. Stored only on this phone.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#141210",
  "theme_color": "#141210",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add task",
      "short_name": "Add",
      "description": "Type a new school task",
      "url": "./?action=add",
      "icons": [{ "src": "icons/shortcut-add.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Speak task",
      "short_name": "Speak",
      "description": "Say a task out loud",
      "url": "./?action=speak",
      "icons": [{ "src": "icons/shortcut-speak.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text"
    }
  }
}
