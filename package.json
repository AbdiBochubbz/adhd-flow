{
  "name": "still",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "dev": "vite --host 0.0.0.0 --port 47321 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 47321 --strictPort",
    "test": "node --test tests/*.test.js",
    "cap:sync": "npm run build && cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "presence": "node server/presence.mjs",
    "account": "node server/account.mjs",
    "desktop:win": "npm run build && electron-builder --win portable --x64"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.still.tasks",
    "productName": "Still",
    "copyright": "Still stays on this device.",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "ws": "^8.22.1"
  }
}
